__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Large/binary artifacts — not reproducible via git, regenerated by scripts
models/*
!models/README.md
indexes/vector/*
indexes/lexical/*
!indexes/vector/.gitkeep
!indexes/lexical/.gitkeep
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Local env / secrets
.env
certs/

# Scratch dir for any locally-downloaded toolchain. JDK 21 (needed by
# MediaPipe's tasks-genai -- see android-app/app/build.gradle) ended up
# installed system-wide instead, at:
#   C:\Program Files\Microsoft\jdk-21.0.12.101-hotspot
# which is what the documented build command uses.
tools/
# Android: downloaded SDK/Gradle (multi-GB, machine-specific, not source) and build output
android-sdk/
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties
server.log
# The built APK IS committed (copied into api/static/ to be served). It was
# ~20KB as a thin WebView wrapper; it's ~10MB now that it bundles the
# MediaPipe + whisper.cpp native libraries for standalone on-device mode.
# Kept in git deliberately despite being a build artifact: without it the
# server has nothing to hand out, and rebuilding needs the whole Android
# toolchain (SDK + Gradle + JDK 21), none of which is committed. Regenerate
# with: scripts/build_android_assets.py, then gradle assembleDebug.

# Standalone on-device model files (hundreds of MB each) -- served from
# here for the app to download once over local Wi-Fi, never committed.
src/disaster_assistant/api/static/*.task
src/disaster_assistant/api/static/*.bin
android-app/app/src/main/assets/models/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
